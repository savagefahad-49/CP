#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main() {
    int n;
    cin >> n; 
    vector<int> num(n); 
    int total_sum = 0;
    for (int a = 0; a < n; a++) {
        cin >> num[a];
        total_sum += num[a]; 
    }
    sort(num.begin(), num.end(), greater<int>());
    int my_sum = 0;
    int count = 0;
    for (int i = 0; i < n; i++) {
        my_sum += num[i];
        count++;
        if (my_sum > (total_sum - my_sum)) {
            break;
        }
    }
    cout << count;
    return 0;
}
