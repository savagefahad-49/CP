#include <iostream>
#include <vector>
using namespace std;
int main() {
    int n;
    cin >> n;
    vector<int> ans(n);
    for (int i=1;i<=n;++i) {
        int p;
        cin >> p;
        ans[p-1]=i; 
    }
    for (int i=0;i<n;++i) {
        cout<<ans[i]<<(i == n-1 ? "":" ");
    }
    cout << "\n";
    return 0;
}
