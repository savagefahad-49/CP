class Solution {
public:
    int numJewelsInStones(string jewels, string stones) {
        int n=0;
        for(int a = 0;a < jewels.length();a++){
            for(int i=0;i<stones.length();i++){
                if(jewels[a]==stones[i]){
                n++;
                }
            }
        }
        return n;
    }
};
