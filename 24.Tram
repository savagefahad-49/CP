#include<iostream>
#include<vector>
#include<algorithm> //for max_element
using namespace std;
int main(){
    int a,b,n;
    cin>>n;
    vector<int> round(n);
    for(int i=1;i<=n;i++){
        cin>>a;
        cin>>b;
        if(i==1){
            round[i-1] = b-a;
        }
        else if(i==n){
            round[i-1] = a-b;
        }
        else{
            round[i-1] = round[i-2] - a + b;
        }
    }
    int greatest = *max_element(round.begin(),round.end());
    cout<<greatest;
    return 0;
}
