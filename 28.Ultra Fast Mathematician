#include<iostream>
#include<string>
using namespace std;
int main(){
    string n1;
    string n2;
    string n3;
    cin>>n1;
    cin>>n2;
    n3.resize(n1.length());
    for(int a=0;a<n1.length();a++){
        if(n1[a]==n2[a]){
            n3[a]='0';
        }
        else{
            n3[a]='1';
        }
    }
    cout<<n3;
    return 0;
}
