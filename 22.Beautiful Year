#include<iostream>
using namespace std;
int main(){
    int year;
    cin>>year;
    year++;
    while(true){
        int a = year/1000;
        int b = (year / 100) % 10;
        int c = (year / 10) % 10;
        int d = year % 10;
        if(a!=b && b!=c && c!=d && a!=c && a!=d && b!=d){
            cout<<year;
            break;
        }
        else{
            year++;
        }
    }
    return 0;
}
